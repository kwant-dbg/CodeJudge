# Environment Configuration for Different Deployments

# Authentication & Security
# JWT Secret (generate a strong random secret for production)
# Example: openssl rand -base64 32
JWT_SECRET=your-secret-key-here

# Admin User Seeding (optional - leave empty to skip auto-creation)
# WARNING: Do not commit real credentials to version control!
# Set these via environment variables or Azure Key Vault in production
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Database Configuration
# Local Development
DATABASE_URL=postgres://user:password@localhost:5432/codejudgedb?sslmode=disable
REDIS_URL=redis://localhost:6379

# Azure Production (PostgreSQL Flexible Server + Redis Cache)
# DATABASE_URL=postgresql://codejudge@your-pg-server:password@your-pg-server.postgres.database.azure.com:5432/codejudge?sslmode=require
# REDIS_URL=rediss://your-redis.redis.cache.windows.net:6380?password=your-redis-key

# Service Configuration
PROBLEMS_SERVICE_URL=http://problems:8000
SUBMISSIONS_SERVICE_URL=http://submissions:8001
PLAGIARISM_SERVICE_URL=http://plagiarism:8002

# Storage (for submissions)
SUBMISSION_STORAGE_PATH=/app/submissions
# For Azure: SUBMISSION_STORAGE_PATH=/mnt/azure-files/submissions

# Plagiarism Detection Configuration
PLAGIARISM_MAX_COMPARISONS=1000
PLAGIARISM_SIMILARITY_THRESHOLD=0.8

# Monitoring & Logging
LOG_LEVEL=info
# For production: LOG_LEVEL=warn